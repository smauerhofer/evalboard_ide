<UserControl x:Class="Ga144.Evb.Ide.Controls.BoardViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="640"
             MinHeight="390">
    <Grid>
        <Border Background="#19271E" BorderBrush="#58705F" BorderThickness="1" CornerRadius="4" Padding="10">
            <Viewbox Stretch="Uniform">
                <Grid Width="760" Height="452">
                    <Image x:Name="BoardImage" Stretch="Fill" SnapsToDevicePixels="True" />
                    <Canvas x:Name="OverlayCanvas" Width="760" Height="452" />
                    <Border x:Name="NoBoardPanel" Background="#E8F0EA" BorderBrush="#7B9781" BorderThickness="2" CornerRadius="6"
                            Width="430" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Select an EVB001 or EVB002 in the Boards list to display its board image."
                                   TextWrapping="Wrap" FontSize="18" TextAlignment="Center" VerticalAlignment="Center" Margin="20" />
                    </Border>
                </Grid>
            </Viewbox>
        </Border>
    </Grid>
</UserControl>
