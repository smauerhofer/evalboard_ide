<Window x:Class="Ga144.Evb.Ide.Views.PostMortemNodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding CoordinateText, StringFormat='Node {0} post-mortem'}"
        Width="920"
        Height="760"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <Border Width="24"
                      Height="24"
                      Background="{Binding Brush}"
                      BorderBrush="#999999"
                      BorderThickness="1"
                      CornerRadius="3"
                      Margin="0,0,8,0" />
      <TextBlock Text="{Binding CoordinateText, StringFormat='Node {0}'}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Text="  -- read failed"
                       Foreground="#B33A3A"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Visibility="{Binding ErrorVisibility}" />
    </StackPanel>

    <TextBlock Grid.Row="1"
                     Foreground="#B33A3A"
                     Margin="0,0,0,8"
                     TextWrapping="Wrap"
                     Text="{Binding Snapshot.Error, StringFormat='Reading this node failed: {0}. The values below are unread defaults, not real chip state.'}"
                     Visibility="{Binding ErrorVisibility}" />

    <Border Grid.Row="2" Background="#EEF4EF" BorderBrush="#C6D5C9" BorderThickness="1" Padding="8" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,24,0">
          <TextBlock FontWeight="SemiBold" Text="Registers" />
          <TextBlock FontFamily="Consolas" Text="{Binding AText, StringFormat='A:  {0}'}" />
          <TextBlock FontFamily="Consolas" Text="{Binding IoText, StringFormat='IO: {0}'}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="0,0,24,0">
          <TextBlock FontWeight="SemiBold" Text="Parameter stack (top first)" />
          <ItemsControl ItemsSource="{Binding ParameterStackRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock FontFamily="Consolas">
                  <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                  <Run Text=": " />
                  <Run Text="{Binding ValueText, Mode=OneWay}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock FontWeight="SemiBold" Text="Return stack (top first)" />
          <ItemsControl ItemsSource="{Binding ReturnStackRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock FontFamily="Consolas">
                  <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                  <Run Text=": " />
                  <Run Text="{Binding ValueText, Mode=OneWay}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="3">
      <TabItem Header="RAM">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                             Margin="0,4,0,4"
                             Foreground="#555"
                             TextWrapping="Wrap"
                             Text="A row shown in italics may be an inline literal (the word right after a '@p'/'!p' in the previous word), not real code -- disassembling a raw memory dump cannot always tell the two apart for certain. A shaded row differs from this project's currently compiled RAM at that address." />
          <ListView ItemsSource="{Binding RamRows}">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                    <Setter Property="Background" Value="#FBD9D9" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding MayBeLiteral}" Value="True">
                    <Setter Property="FontStyle" Value="Italic" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Address" DisplayMemberBinding="{Binding AddressHex}" Width="60" />
                <GridViewColumn Header="Label" DisplayMemberBinding="{Binding Label}" Width="90" />
                <GridViewColumn Header="Hex" DisplayMemberBinding="{Binding HexText}" Width="60" />
                <GridViewColumn Header="On-chip" DisplayMemberBinding="{Binding Disassembly}" Width="200" />
                <GridViewColumn Header="Hex" DisplayMemberBinding="{Binding CompiledHexText}" Width="60" />
                <GridViewColumn Header="Compiled" DisplayMemberBinding="{Binding CompiledDisassembly}" Width="200" />
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
      <TabItem Header="ROM">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                             Margin="0,4,0,4"
                             Foreground="#555"
                             TextWrapping="Wrap"
                             Text="Same notes as the RAM tab: italics may be an inline literal, shading is a difference from this project's currently compiled ROM." />
          <ListView ItemsSource="{Binding RomRows}">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                    <Setter Property="Background" Value="#FBD9D9" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding MayBeLiteral}" Value="True">
                    <Setter Property="FontStyle" Value="Italic" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Address" DisplayMemberBinding="{Binding AddressHex}" Width="60" />
                <GridViewColumn Header="Label" DisplayMemberBinding="{Binding Label}" Width="90" />
                <GridViewColumn Header="Hex" DisplayMemberBinding="{Binding HexText}" Width="60" />
                <GridViewColumn Header="On-chip" DisplayMemberBinding="{Binding Disassembly}" Width="200" />
                <GridViewColumn Header="Hex" DisplayMemberBinding="{Binding CompiledHexText}" Width="60" />
                <GridViewColumn Header="Compiled" DisplayMemberBinding="{Binding CompiledDisassembly}" Width="200" />
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
    </TabControl>
  </Grid>
</Window>