<Window x:Class="Ga144.Evb.Ide.Views.MacroEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="F18 source macros"
        Width="1100"
        Height="760"
        MinWidth="840"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="F18 source macros" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Use &lt;macro-name&gt; import. The macro source is inserted as text before compilation; nested imports are expanded recursively."
                       TextWrapping="Wrap" Foreground="#555" Margin="0,3,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="System macros">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox ItemsSource="{Binding SystemMacros, Mode=OneWay}"
                                 SelectedItem="{Binding SelectedSystemMacro}"
                                 DisplayMemberPath="Name" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Add" Command="{Binding AddSystemMacroCommand, Mode=OneWay}" MinWidth="80" />
                            <Button Content="Remove" Command="{Binding RemoveSystemMacroCommand, Mode=OneWay}" MinWidth="80" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Name" FontWeight="SemiBold" />
                        <TextBox Grid.Row="1" Text="{Binding SelectedSystemMacro.Name, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                        <TextBox Grid.Row="2" Text="{Binding SelectedSystemMacro.Description, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,7,0,7" ToolTip="Optional description" />
                        <TextBox Grid.Row="3" Text="{Binding SelectedSystemMacro.SourceCode, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="14"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" SpellCheck.IsEnabled="False" />
                        <TextBlock Grid.Row="4" Margin="0,7,0,0" Foreground="#555" TextWrapping="Wrap"
                                   Text="System macros are stored in the system-wide GA144 ROM library. ROM and RAM may import them. A system macro may nest only other system macros." />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Project user macros">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox ItemsSource="{Binding UserMacros, Mode=OneWay}"
                                 SelectedItem="{Binding SelectedUserMacro}"
                                 DisplayMemberPath="Name" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Add" Command="{Binding AddUserMacroCommand, Mode=OneWay}" MinWidth="80" />
                            <Button Content="Remove" Command="{Binding RemoveUserMacroCommand, Mode=OneWay}" MinWidth="80" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Name" FontWeight="SemiBold" />
                        <TextBox Grid.Row="1" Text="{Binding SelectedUserMacro.Name, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                        <TextBox Grid.Row="2" Text="{Binding SelectedUserMacro.Description, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,7,0,7" ToolTip="Optional description" />
                        <TextBox Grid.Row="3" Text="{Binding SelectedUserMacro.SourceCode, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="14"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" SpellCheck.IsEnabled="False" />
                        <TextBlock Grid.Row="4" Margin="0,7,0,0" Foreground="#555" TextWrapping="Wrap">
                            <Run Text="User macros belong to project " /><Run Text="{Binding ProjectName, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=". RAM may import them; ROM and system macros cannot. User macros may nest user or system macros. A user macro shadows a same-named system macro in RAM." />
                        </TextBlock>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Width="790">
                <TextBlock Text="{Binding ValidationMessage, Mode=OneWay}" Foreground="#B00020" TextWrapping="Wrap" />
                <TextBlock Foreground="#555" TextTrimming="CharacterEllipsis">
                    <Run Text="System library: " /><Run Text="{Binding RomLibraryPath, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
            <Button Content="Save macros" IsDefault="True" Click="OnSaveClick" MinWidth="110" Margin="8,0,0,0" />
        </DockPanel>
    </Grid>
</Window>
