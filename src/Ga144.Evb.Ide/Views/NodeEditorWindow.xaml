<Window x:Class="Ga144.Evb.Ide.Views.NodeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Node editor"
        Width="1240"
        Height="860"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Left">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Node " FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="{Binding NodeCoordinate}" FontSize="24" FontWeight="SemiBold" FontFamily="Consolas" />
        </StackPanel>
        <TextBlock Text="{Binding KrakenOnlineHint}" Foreground="#555" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Copy to project…" Click="OnCopyToProjectClick" Padding="10,5" Margin="0,0,12,0"
                        ToolTip="Copy this node's RAM source and startup state into the same node coordinate in another open project. ROM is shared across all projects and is not copied." />
        <Button Content="Online Kraken…" Click="OnOnlineKrakenClick"
                        IsEnabled="{Binding KrakenOnlineAvailable}" Padding="10,5" Margin="0,0,12,0"
                        ToolTip="Open live RAM/ROM/register/stack/I/O control through the installed Kraken tentacle." />
        <CheckBox Content="Include this node in project boot/startup" IsChecked="{Binding Enabled}"
                          VerticalAlignment="Center" />
        <CheckBox Content="Include this node in post-mortem analysis" IsChecked="{Binding PostMortemEnabled}"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          ToolTip="Whether Core Dump reads this node's own registers, both stacks, and RAM/ROM. Unchecking this only skips this node's own data -- the tentacle wire walk still passes through it to reach later nodes on the same tentacle, so it does not change what gets erected, only what gets read." />
      </StackPanel>
    </DockPanel>

    <!--
        Stefan's own request, 2026-09-25: "remove the color selection grid and replace the
        selected color[] with a color selection pulldown-menu and display the selected color as
        the current element", replacing the old 4x12 swatch-grid picker below the label with a
        single ComboBox. The "current color" swatch (Stefan's own "current node color button")
        stays exactly where it was, right after the label, always showing the effective color as
        its own small element; the ComboBox's own closed state does the same job for whichever
        color is actually selected, since its ItemTemplate (a swatch + number + hex, same as
        every entry in its dropdown list) is what renders in the closed box too.
    -->
    <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" Text="Node color:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
      <!--
          The "current color" swatch also carries its color's 2-digit hex Number, same
          translucent-pill technique as the ComboBox's own per-item swatches below, via a Grid so
          the badge can sit on top of the swatch itself.
      -->
      <Grid DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
        <Grid.ToolTip>
          <MultiBinding StringFormat="{}{0}  {1}">
            <Binding Path="EffectiveColorNumber" />
            <Binding Path="EffectiveColorHex" />
          </MultiBinding>
        </Grid.ToolTip>
        <Border CornerRadius="4"
                          Background="{Binding EffectiveColorBrush}" BorderBrush="#999999" BorderThickness="1" />
        <Border Background="#B3FFFFFF" CornerRadius="2" Padding="2,0"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock Text="{Binding EffectiveColorNumber}" FontSize="8" FontWeight="Bold" Foreground="#333333" />
        </Border>
      </Grid>
      <!--
          The pulldown menu itself: one entry per NodeColorPalette swatch (48 total), each shown
          as its own small swatch + 2-digit hex Number + hex string, so nothing shown by the old
          picker grid is lost, just laid out as a dropdown list instead of a fixed 4x12 grid.
          SelectedItem is two-way bound to SelectedColorOption, which both reads back whichever
          entry matches this node's current EffectiveColorHex (so the ComboBox opens already
          pointed at the current element) and applies a newly picked entry via SetColor.
      -->
      <ComboBox DockPanel.Dock="Left" Width="200" VerticalAlignment="Center"
                        ItemsSource="{Binding ColorOptions}"
                        SelectedItem="{Binding SelectedColorOption}"
                        ToolTip="Pick one of the 48 NodeColorPalette swatches as this node's own color override.">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,6,0"
                                      Background="{Binding Brush}" BorderBrush="#999999" BorderThickness="1" />
              <TextBlock Text="{Binding Number}" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,6,0" />
              <TextBlock Text="{Binding Hex}" Foreground="#555555" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button DockPanel.Dock="Left" Content="Use project default" Click="OnUseProjectDefaultColorClick"
                      Margin="10,0,0,0" Padding="8,3" MinHeight="24" VerticalAlignment="Center"
                      ToolTip="Clears this node's own color so it goes back to following the project's default node color (set in MainWindow's Active project panel)." />
    </DockPanel>

    <TabControl Grid.Row="2">
      <TabItem Header="RAM source">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,7">
            <StackPanel DockPanel.Dock="Left">
              <TextBlock Text="Project-specific F18A RAM source for this node. The node's ROM dictionary is automatically in scope."
                                       FontWeight="SemiBold" />
              <TextBlock Text="Example: 0 org   entry start   : start io b! begin @b !b again ;"
                                       FontFamily="Consolas" Foreground="#555" Margin="0,3,0,0" />
            </StackPanel>
            <Button Content="Compile ROM + RAM" Command="{Binding CompileCommand}" DockPanel.Dock="Right"
                                MinWidth="150" MinHeight="32" Margin="12,0,0,0" />
          </DockPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnGutteredSourceScrollViewerPreviewMouseWheel">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding SourceLineNumberGutterText, Mode=OneWay}"
                                     IsReadOnly="True" IsTabStop="False"
                                     AcceptsReturn="True" BorderThickness="0"
                                     Background="#F4F4F4" Foreground="#666"
                                     FontFamily="Consolas" FontSize="14"
                                     Padding="2,0,8,0" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollBarVisibility="Disabled"
                                     IsInactiveSelectionHighlightEnabled="True" />
              <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                <TextBox Text="{Binding SourceCode, UpdateSourceTrigger=PropertyChanged}"
                                       AcceptsReturn="True" AcceptsTab="True"
                                       BorderThickness="0" Padding="2,0,2,0"
                                       FontFamily="Consolas" FontSize="14"
                                       TextWrapping="NoWrap" SpellCheck.IsEnabled="False"
                                       VerticalScrollBarVisibility="Disabled"
                                       HorizontalScrollBarVisibility="Disabled" />
              </ScrollViewer>
            </Grid>
          </ScrollViewer>

          <Border Grid.Row="2" Background="#F4F4F4" BorderBrush="#D0D0D0" BorderThickness="1"
                            Padding="8" Margin="0,7,0,0">
            <TextBox Text="{Binding CompilationStatus, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 IsInactiveSelectionHighlightEnabled="True" />
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="ROM source">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,7">
            <StackPanel DockPanel.Dock="Left">
              <TextBlock Text="System-wide F18A ROM source for this GA144 node (addresses 0x080 through 0x0BF)."
                                       FontWeight="SemiBold" />
              <TextBlock Foreground="#555" Margin="0,3,0,0" TextWrapping="Wrap">
                                <Run Text="This source is shared by every project and by Host/Target chips. System macros available: " />
                                <Run Text="{Binding SystemMacroCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=". Library: " />
                                <Run Text="{Binding RomLibraryPath, Mode=OneWay}" FontFamily="Consolas" />
              </TextBlock>
            </StackPanel>
            <Button Content="Compile ROM" Command="{Binding CompileRomCommand}" DockPanel.Dock="Right"
                                MinWidth="150" MinHeight="32" Margin="12,0,0,0" />
          </DockPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnGutteredSourceScrollViewerPreviewMouseWheel">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding RomSourceLineNumberGutterText, Mode=OneWay}"
                                     IsReadOnly="True" IsTabStop="False"
                                     AcceptsReturn="True" BorderThickness="0"
                                     Background="#F4F4F4" Foreground="#666"
                                     FontFamily="Consolas" FontSize="14"
                                     Padding="2,0,8,0" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollBarVisibility="Disabled"
                                     IsInactiveSelectionHighlightEnabled="True" />
              <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                <TextBox Text="{Binding RomSourceCode, UpdateSourceTrigger=PropertyChanged}"
                                       AcceptsReturn="True" AcceptsTab="True"
                                       BorderThickness="0" Padding="2,0,2,0"
                                       FontFamily="Consolas" FontSize="14"
                                       TextWrapping="NoWrap" SpellCheck.IsEnabled="False"
                                       VerticalScrollBarVisibility="Disabled"
                                       HorizontalScrollBarVisibility="Disabled" />
              </ScrollViewer>
            </Grid>
          </ScrollViewer>

          <Border Grid.Row="2" Background="#FFF7DF" BorderBrush="#D7BE74" BorderThickness="1"
                            Padding="8" Margin="0,7,0,0">
            <TextBlock TextWrapping="Wrap"
                                   Text="ROM is compiled before RAM. Exported ROM words, labels, and constants are automatically visible while compiling this node's RAM source. Saving this node updates the system-wide ga144-rom.yaml library." />
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Expanded macro source">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid Grid.Column="0" Margin="0,0,6,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Expanded RAM source" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,5" />
            <TextBox Grid.Row="1" Text="{Binding ExpandedRamSource, Mode=OneWay}" IsReadOnly="True"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                                 TextWrapping="NoWrap" />
          </Grid>

          <Grid Grid.Column="1" Margin="6,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Expanded ROM source" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,5" />
            <TextBox Grid.Row="1" Text="{Binding ExpandedRomSource, Mode=OneWay}" IsReadOnly="True"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                                 TextWrapping="NoWrap" />
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Compiler output">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,7">
            <TextBlock Text="ROM is compiled first; RAM is compiled only when the ROM dictionary succeeds."
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="Compile ROM + RAM" Command="{Binding CompileCommand}" DockPanel.Dock="Right"
                                MinWidth="150" MinHeight="30" Margin="12,0,0,0" />
          </DockPanel>

          <TabControl Grid.Row="1">
            <TabItem Header="Diagnostics">
              <TextBox Margin="6" Text="{Binding CompilationDiagnostics, Mode=OneWay}" IsReadOnly="True"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
                                     TextWrapping="NoWrap" />
            </TabItem>
            <TabItem Header="ROM listing">
              <TextBox Margin="6" Text="{Binding RomCompilationListing, Mode=OneWay}" IsReadOnly="True"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
                                     TextWrapping="NoWrap" />
            </TabItem>
            <TabItem Header="RAM listing">
              <TextBox Margin="6" Text="{Binding CompilationListing, Mode=OneWay}" IsReadOnly="True"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
                                     TextWrapping="NoWrap" />
            </TabItem>
            <TabItem Header="Symbols / compile-time stacks">
              <TextBox Margin="6" Text="{Binding CompilationSymbols, Mode=OneWay}" IsReadOnly="True"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
                                     TextWrapping="NoWrap" />
            </TabItem>
          </TabControl>
        </Grid>
      </TabItem>

      <TabItem Header="RAM and startup">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" Text="Compiled RAM image (one 18-bit word per line, addresses 0x000 through 0x03F)"
                                     FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button DockPanel.Dock="Right" Content="Copy MD" Command="{Binding CopyRamMarkdownCommand}"
                                Padding="8,2"
                                ToolTip="Copies this RAM image (Address/Label/Hex/Disassembly, one row per word) to the clipboard as a Markdown table." />
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto" Margin="0,5,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding RamAddressGutterText, Mode=OneWay}"
                                       IsReadOnly="True" IsTabStop="False"
                                       AcceptsReturn="True" BorderThickness="0"
                                       Background="#F4F4F4" Foreground="#666"
                                       FontFamily="Consolas" FontSize="13"
                                       Padding="2,0,8,0" TextWrapping="NoWrap"
                                       VerticalScrollBarVisibility="Disabled"
                                       HorizontalScrollBarVisibility="Disabled"
                                       IsInactiveSelectionHighlightEnabled="True" />
                <TextBox Grid.Column="1" Text="{Binding RamLabelGutterText, Mode=OneWay}"
                                       IsReadOnly="True" IsTabStop="False"
                                       AcceptsReturn="True" BorderThickness="0"
                                       Background="#F4F4F4" Foreground="#666"
                                       FontFamily="Consolas" FontSize="13"
                                       Padding="2,0,8,0" TextWrapping="NoWrap" MinWidth="80"
                                       VerticalScrollBarVisibility="Disabled"
                                       HorizontalScrollBarVisibility="Disabled"
                                       IsInactiveSelectionHighlightEnabled="True"
                                       ToolTip="The name this node's own last successful RAM compile binds to that address, if any." />
                <TextBox Grid.Column="2" Text="{Binding RamWordsText, UpdateSourceTrigger=PropertyChanged}"
                                       AcceptsReturn="True" MinWidth="120"
                                       BorderThickness="0" Padding="2,0,2,0"
                                       FontFamily="Consolas" FontSize="13"
                                       TextWrapping="NoWrap" SpellCheck.IsEnabled="False"
                                       VerticalScrollBarVisibility="Disabled"
                                       HorizontalScrollBarVisibility="Disabled" />
                <TextBox Grid.Column="3" Text="{Binding RamDisassemblyGutterText, Mode=OneWay}"
                                       IsReadOnly="True" IsTabStop="False"
                                       AcceptsReturn="True" BorderThickness="0"
                                       Background="#F4F4F4" Foreground="#666"
                                       FontFamily="Consolas" FontSize="13"
                                       Padding="8,0,2,0" TextWrapping="NoWrap" MinWidth="160"
                                       VerticalScrollBarVisibility="Disabled"
                                       HorizontalScrollBarVisibility="Disabled"
                                       IsInactiveSelectionHighlightEnabled="True"
                                       ToolTip="Decoded from whatever is currently in the Hex column, so it always matches even a hand edit made without recompiling." />
              </Grid>
            </ScrollViewer>
          </Grid>

          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Startup registers" FontWeight="SemiBold" FontSize="15" />
              <UniformGrid Columns="2" Margin="0,6,0,8">
                <StackPanel Margin="0,0,6,0">
                  <TextBlock Text="Entry point" />
                  <TextBox Text="{Binding EntryPoint, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="P" />
                  <TextBox Text="{Binding P, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                </StackPanel>
                <StackPanel Margin="0,0,6,0">
                  <TextBlock Text="A" />
                  <TextBox Text="{Binding A, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="B" />
                  <TextBox Text="{Binding B, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                </StackPanel>
              </UniformGrid>
              <TextBlock Text="IO" />
              <TextBox Text="{Binding Io, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />

              <TextBlock Text="Return stack (bottom to top, maximum 9)" FontWeight="SemiBold" Margin="0,8,0,2" />
              <TextBox Text="{Binding ReturnStackText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" Height="125" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />

              <TextBlock Text="Parameter stack (bottom to top, maximum 10)" FontWeight="SemiBold" Margin="0,8,0,2" />
              <TextBox Text="{Binding ParameterStackText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" Height="135" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="System ROM image">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Compiled ROM image (one 18-bit word per line, addresses 0x080 through 0x0BF)"
                                 FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Copy MD" Command="{Binding CopyRomMarkdownCommand}"
                              Padding="8,2"
                              ToolTip="Copies this ROM image (Address/Label/Hex/Disassembly, one row per word) to the clipboard as a Markdown table." />
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto" Margin="0,5,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding RomAddressGutterText, Mode=OneWay}"
                                     IsReadOnly="True" IsTabStop="False"
                                     AcceptsReturn="True" BorderThickness="0"
                                     Background="#F4F4F4" Foreground="#666"
                                     FontFamily="Consolas" FontSize="13"
                                     Padding="2,0,8,0" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollBarVisibility="Disabled"
                                     IsInactiveSelectionHighlightEnabled="True" />
              <TextBox Grid.Column="1" Text="{Binding RomLabelGutterText, Mode=OneWay}"
                                     IsReadOnly="True" IsTabStop="False"
                                     AcceptsReturn="True" BorderThickness="0"
                                     Background="#F4F4F4" Foreground="#666"
                                     FontFamily="Consolas" FontSize="13"
                                     Padding="2,0,8,0" TextWrapping="NoWrap" MinWidth="80"
                                     VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollBarVisibility="Disabled"
                                     IsInactiveSelectionHighlightEnabled="True"
                                     ToolTip="The name this node's own last successful ROM compile binds to that address, if any." />
              <TextBox Grid.Column="2" Text="{Binding RomWordsText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" MinWidth="120"
                                     BorderThickness="0" Padding="2,0,2,0"
                                     FontFamily="Consolas" FontSize="13"
                                     TextWrapping="NoWrap" SpellCheck.IsEnabled="False"
                                     VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollBarVisibility="Disabled" />
              <TextBox Grid.Column="3" Text="{Binding RomDisassemblyGutterText, Mode=OneWay}"
                                     IsReadOnly="True" IsTabStop="False"
                                     AcceptsReturn="True" BorderThickness="0"
                                     Background="#F4F4F4" Foreground="#666"
                                     FontFamily="Consolas" FontSize="13"
                                     Padding="8,0,2,0" TextWrapping="NoWrap" MinWidth="160"
                                     VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollBarVisibility="Disabled"
                                     IsInactiveSelectionHighlightEnabled="True"
                                     ToolTip="Decoded from whatever is currently in the Hex column, so it always matches even a hand edit made without recompiling." />
            </Grid>
          </ScrollViewer>
          <Border Grid.Row="2" Background="#EEF5EF" BorderBrush="#B9CCBD" BorderThickness="1"
                            Padding="8" Margin="0,7,0,0">
            <TextBlock TextWrapping="Wrap">
                            <Run Text="This image and its source are stored in the system-wide ROM library: " />
                            <Run Text="{Binding RomLibraryPath, Mode=OneWay}" FontFamily="Consolas" />
                            <Run Text=". The image is not part of the per-project workspace." />
            </TextBlock>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Width="900">
        <TextBlock Text="A successful compile replaces the ROM image first and then the RAM image; RAM entry point is updated from the RAM compile. Save node persists project RAM/startup state and any changed system ROM source/image."
                           TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#555" />
        <TextBlock Foreground="#777" Margin="0,2,0,0">
                    <Run Text="Macros: " /><Run Text="{Binding SystemMacroCount, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" system, " /><Run Text="{Binding UserMacroCount, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" project user." />
        </TextBlock>
      </StackPanel>
      <Button Content="Cancel" Click="OnCancelClick" MinWidth="90" Margin="8,0,0,0" />
      <Button Content="Save node" IsDefault="True" Click="OnSaveClick" MinWidth="110" Margin="8,0,0,0" />
    </DockPanel>
  </Grid>
</Window>