<Window x:Class="Ga144.Evb.Ide.Views.ChipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GA144 chip"
        Width="1992"
        Height="1104"
        MinWidth="1512"
        MinHeight="864"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="{Binding KrakenStatusText, Mode=OneWay}"
                           Foreground="#555"
                           Margin="0,2,12,0"
                           TextWrapping="Wrap" />
      </StackPanel>

      <TextBlock Grid.Column="1"
                       Margin="18,0"
                       Text="Rows 7 to 0, columns 00 to 17. Port markers show the available north/east/south/west COM links; the small u/d/l/r letters give each link's local F18 port name (up/down/left/right), which is mirrored on alternating rows/columns."
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="#555"
                       TextWrapping="Wrap" />

      <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Button Content="Check Kraken"
                          Click="OnCheckKrakenClick"
                          IsEnabled="True"
                          Padding="12,6"
                          Margin="0,0,8,0"
                          ToolTip="Erect Kraken once if necessary, then verify RAM[0] outward from node 708. The COM endpoint remains reserved, but its native handle is parked whenever no Kraken operation is active." />
          <Button Content="{Binding KrakenButtonText, Mode=OneWay}"
                          Command="{Binding ToggleKrakenCommand}"
                          Padding="12,6"
                          Margin="0,0,8,0"
                          ToolTip="Install or remove the project-side Kraken topology on this Host or Target GA144." />
          <Button Content="Verify all node ROMs"
                          Command="{Binding VerifyAllRomsCommand}"
                          Padding="12,6"
                          Margin="0,0,8,0"
                          ToolTip="Compile each node's ROM and compare it against the ROM read from the chip via Kraken. Erects once if needed; reads all 143 reachable nodes through one session. Node 708 (Kraken head) is skipped." />
          <Button Content="Verify node 708 ROM"
                          Command="{Binding VerifyNode708RomCommand}"
                          Padding="12,6"
                          Margin="0,0,8,0"
                          ToolTip="Direct-boot readback of node 708's own ROM (it cannot be read through Kraken). Resets the chip once to load a one-shot dump-rom program, so this is blocked while a Kraken is erected -- remove the Kraken first." />
          <Button Content="Node 708 echo test"
                          Command="{Binding RunNode708EchoTestCommand}"
                          Padding="12,6"
                          Margin="0,0,8,0"
                          ToolTip="Tests node 708's own direct-UART obit/oword/obyt/echo routines: sends one async-encoded word, node 708 receives it via its own 18ibits/sync and transmits it straight back as real, self-timed UART bytes (no host carrier clocking). Requires node 708's ROM to define '18ibits' and 'delay'. Resets the chip once, so this is blocked while a Kraken is erected." />
          <Button Content="Node 708 dispatch test"
                          Command="{Binding RunNode708DispatchTestCommand}"
                          Padding="12,6"
                          ToolTip="Tests node 708's own main/sett dispatch loop specifically (not obit/oword/obyt/readw, already proven by the echo test): boots main/sett only, then calls 'sett' with the same port value twice in a row over Kraken's own NativeWindowsSerialPort transport, reporting each call's outcome separately. Built to isolate a hardware finding: the same sett call that succeeds once times out on a second call, unrelated to w/r's complexity. Resets the chip once, so this is blocked while a Kraken is erected." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <Button Content="SRAM Tentacle"
                          Click="OnOpenSramTentacleClick"
                          IsEnabled="True"
                          Padding="12,6"
                          Margin="0,0,8,0"
                          ToolTip="Opens the SRAM Tentacle window: installs AN003's SRAM Control Cluster (nodes 007/008/009/107) for a chosen memory-master node (106, 108, or 207), then reads/writes/compare-exchanges words in the eval board's external SRAM and sets node 107's master mask through that master. Requires an online Kraken; the window reports if it is not available." />
          <Button Content="SRAM Simulator (707)"
                          Click="OnOpenSramSimulatorClick"
                          IsEnabled="True"
                          Padding="12,6"
                          Margin="0,0,8,0"
                          ToolTip="Opens the SRAM Simulator window: installs a software stand-in for the real SRAM cluster entirely on node 707 (Tentacle 1, position 0), speaking the same ex@/ex!/cx?/mk!/echo protocol over a small local backing array instead of the real external SRAM chip. Built for CVM (C virtual machine) development -- exercises SRAM-shaped memory traffic over Kraken without the real SRAM Tentacle installed or wired up. Requires an online Kraken; the window reports if it is not available." />
          <Button Content="Copy all nodes to project…"
                          Command="{Binding CopyAllNodesToProjectCommand}"
                          Padding="12,6"
                          Margin="0,0,8,0"
                          ToolTip="Copies every configured node in this chip (enabled, or with non-blank RAM source -- the same nodes highlighted yellow below) into the same node coordinates in another open project. ROM is shared across all projects and is not copied, same policy as the node editor's own 'Copy to project…'." />
          <Button Content="Include all in PM"
                          Command="{Binding IncludeAllInPostMortemCommand}"
                          Padding="12,6"
                          Margin="0,0,8,0"
                          ToolTip="Ticks &quot;Include this node in post-mortem analysis&quot; for all 144 nodes at once, so the next Core Dump reads every node's own data again." />
          <Button Content="Exclude all from PM"
                          Command="{Binding ExcludeAllFromPostMortemCommand}"
                          Padding="12,6"
                          Margin="0,0,8,0"
                          ToolTip="Unticks &quot;Include this node in post-mortem analysis&quot; for all 144 nodes at once. The next Core Dump still walks the whole tentacle wire (unchanged), but reads no node's own data until nodes are re-included, one by one or with 'Include all in PM'." />
          <Button Content="CVM Debugger"
                          Click="OnOpenCvmDebuggerClick"
                          IsEnabled="True"
                          Padding="12,6"
                          Margin="0,0,8,0"
                          ToolTip="Opens the CVM Debugger window: same compile-boot-load-wake sequence as 'Install &amp; run CVM test', but interactive -- step one memory-interface transaction at a time, run to a breakpoint (paused by withholding a read's reply, exactly what the physical CVM is blocked on), and inspect the simulated SRAM. Blocked while a Kraken is erected (this resets the whole chip)." />
          <Button Content="Simulator…"
                          Click="OnOpenSimulatorClick"
                          IsEnabled="True"
                          Padding="12,6"
                          Margin="0,0,8,0"
                          ToolTip="Opens the GA144 simulator: a software-only, tick/tock model of every one of this project's 144 nodes (registers, ports, RAM, ROM), stepped one F18A instruction slot at a time, with no chip or Kraken required." />
          <TextBlock Text="{Binding VerifyStatus, Mode=OneWay}"
                             VerticalAlignment="Center"
                             Margin="10,0,0,0"
                             Foreground="#555" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!--
            Keep the chip surface in the normal WPF layout tree.  Earlier
            versions put a fixed 2448x1152 visual tree inside a Viewbox.
            While the modeless Kraken check DataGrid was receiving frequent
            updates, some WPF/GPU combinations stopped presenting that large
            Viewbox even though its children were still alive.  A normal
            stretching Grid avoids the additional Viewbox render transform and
            keeps the node surface independent of the check window's updates.
        -->
    <Grid x:Name="ChipDrawingGrid"
              Grid.Row="1"
              MinHeight="520"
              ClipToBounds="True"
              Background="White"
              SizeChanged="OnChipDrawingGridSizeChanged">
      <ItemsControl x:Name="NodeItemsControl"
                          ItemsSource="{Binding Nodes}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Panel.ZIndex="0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="18" Rows="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Click="OnNodeClick" Margin="8" Padding="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                ToolTip="{Binding ToolTip}" Tag="{Binding}">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderThickness" Value="0" />
                </Style>
              </Button.Style>
              <Border x:Name="NodeBorder" BorderBrush="{Binding NodeBorderBrushColor}" BorderThickness="{Binding NodeBorderThickness}" Background="{Binding NodeBackgroundBrush}" CornerRadius="4">
                <Grid Margin="4">
                  <Border BorderBrush="{Binding KrakenBrush}"
                                            BorderThickness="3"
                                            CornerRadius="3"
                                            Margin="-2"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding KrakenVisibility}" />

                  <Rectangle Width="22" Height="5" Fill="#365C42" HorizontalAlignment="Center" VerticalAlignment="Top"
                                               Visibility="{Binding NorthVisibility}" />
                  <Rectangle Width="22" Height="5" Fill="#365C42" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                               Visibility="{Binding SouthVisibility}" />
                  <Rectangle Width="5" Height="22" Fill="#365C42" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Visibility="{Binding WestVisibility}" />
                  <Rectangle Width="5" Height="22" Fill="#365C42" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Visibility="{Binding EastVisibility}" />

                  <!--
                        Local F18 port-name letters (u/d/l/r), not compass
                        direction: GA144 mirrors cell orientation on alternating
                        rows/columns, so geographic north/south/east/west maps to
                        a different local up/down/left/right port name from node
                        to node (NodeViewModel.PortLetter / KrakenTopology.PortName).
                  -->
                  <TextBlock Text="{Binding NorthPortLabel}" FontFamily="Consolas" FontWeight="Bold" FontSize="9"
                                               Foreground="#365C42" HorizontalAlignment="Center" VerticalAlignment="Top"
                                               Margin="0,7,0,0" IsHitTestVisible="False" />
                  <TextBlock Text="{Binding SouthPortLabel}" FontFamily="Consolas" FontWeight="Bold" FontSize="9"
                                               Foreground="#365C42" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                               Margin="0,0,0,7" IsHitTestVisible="False" />
                  <TextBlock Text="{Binding WestPortLabel}" FontFamily="Consolas" FontWeight="Bold" FontSize="9"
                                               Foreground="#365C42" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Margin="7,0,0,0" IsHitTestVisible="False" />
                  <TextBlock Text="{Binding EastPortLabel}" FontFamily="Consolas" FontWeight="Bold" FontSize="9"
                                               Foreground="#365C42" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="0,0,7,0" IsHitTestVisible="False" />

                  <!--
                        HorizontalAlignment changed from "Center" to "Stretch" (Stefan's own
                        request, 2026-09-26: a RAM usage line below "configured" that is "scaled to
                        the current width of the node") so this StackPanel now spans the node's own
                        current width. The coordinate/state TextBlocks each keep their own explicit
                        HorizontalAlignment="Center", so they still sit centered exactly as before;
                        only the new Image below them actually uses the extra width.
                  -->
                  <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CoordinateText}" FontFamily="Consolas" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="#406A4B" HorizontalAlignment="Center" />
                    <!--
                          ADDED 2026-09-26, per Stefan directly: "below 'configured' text a 2 pixel
                          high line that represents the usage state of a node. used words are red,
                          free words are green. left is address 0x00, right is address 0x3f. every
                          word is 1 pixel wide. this line is then scaled to the current width of
                          the node." NodeViewModel.RamUsageBitmap is a 64x1 image, one pixel per RAM
                          word; NearestNeighbor scaling keeps each word's pixel a hard-edged band
                          instead of a blurred gradient once Stretch="Fill" scales it up to the
                          node's actual width. Hidden entirely (RamUsageVisibility) until the node
                          has at least one used word, exactly as asked.
                    -->
                    <Image Source="{Binding RamUsageBitmap}"
                                           Visibility="{Binding RamUsageVisibility}"
                                           Height="2" Margin="0,3,0,0"
                                           Stretch="Fill"
                                           SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           IsHitTestVisible="False" />
                  </StackPanel>

                  <!-- ADDED 2026-09-25, per Stefan directly: "add the small node color number in
                       the top left of each node." Mirrors the same 2-digit hex number already
                       stamped on every NodeColorPalette picker swatch. Placed before the Kraken
                       badge below (drawn on top of this one in z-order), so an active Kraken
                       tentacle/head label still wins the corner on the rare node where both show
                       at once. -->
                  <Border Background="#B3FFFFFF" CornerRadius="2"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Padding="3,1"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding NodeColorNumberVisibility}">
                    <TextBlock Text="{Binding NodeColorNumber}" FontSize="9" FontWeight="Bold" Foreground="#333333" />
                  </Border>

                  <Border Background="{Binding KrakenBrush}"
                                            CornerRadius="3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Padding="3,1"
                                            Visibility="{Binding KrakenVisibility}">
                    <TextBlock Text="{Binding KrakenLabel}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                  </Border>

                  <Border Background="#D7E7DA" BorderBrush="#5A8664" BorderThickness="1" CornerRadius="3"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="3,1"
                                            Visibility="{Binding ExternalIoVisibility}">
                    <TextBlock Text="I/O" FontSize="11" FontWeight="Bold" />
                  </Border>

                  <!-- ADDED 2026-09-22: hint for whether Core Dump reads this node's own data,
                       independent of the "configured for boot" color/border above. -->
                  <Border Background="#D8E3F5" BorderBrush="#4C6FA8" BorderThickness="1" CornerRadius="3"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Padding="3,1"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding PostMortemHintVisibility}">
                    <TextBlock Text="PM" FontSize="10" FontWeight="Bold" Foreground="#2A4570" />
                  </Border>
                </Grid>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Canvas x:Name="KrakenPathCanvas"
                    IsHitTestVisible="False"
                    Panel.ZIndex="10" />
    </Grid>

    <Border Grid.Row="2" Background="#EEF4EF" BorderBrush="#C6D5C9" BorderThickness="1" Padding="8" Margin="0,8,0,0">
      <TextBlock Text="Click a node to edit its F18 source, ROM, compiled RAM words, entry point, registers, and startup stacks. Configured nodes are highlighted using this project's default node color, or a node's own color if it was given one in the node editor. A blue &quot;PM&quot; badge in a node's top-right corner means Core Dump will read that node's own data during post-mortem capture; nodes without the badge are still transited by the tentacle wire walk (needed to reach later nodes) but their own registers/stacks/RAM/ROM are skipped, which is what actually saves time. &quot;Include all in PM&quot; and &quot;Exclude all from PM&quot; above set that checkbox for all 144 nodes at once instead of one node editor at a time. When a Kraken is installed, colored arrows show each tentacle's directed path from node 708. Check Kraken verifies RAM[0] outward from the three direct neighbors along all tentacles. Once hardware Kraken is erected, its COM endpoint remains exclusively reserved and all subsequent chip access goes through Kraken/Tentacles; the native handle is opened only for explicit operations and parked while idle. Reset, node-708 probe, port reassignment, and re-erection are disabled."
                       TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>