<Window x:Class="Ga144.Evb.Ide.Views.SramSimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SRAM Simulator (node 707)"
        Width="720"
        Height="780"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="SRAM Simulator (node 707)" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Margin="0,3,0,0" Foreground="#555" TextWrapping="Wrap"
                       Text="A software stand-in for the real SRAM Tentacle, resident entirely on node 707 (Tentacle 1, position 0 -- one hop from the Kraken head). Speaks the exact same ex@/ex!/cx?/mk!/echo protocol as the real AN003 cluster, backed by a small local array instead of the external SRAM chip, so CVM (C virtual machine) development can exercise SRAM-shaped memory traffic over Kraken without the real cluster installed or wired up." />
    </StackPanel>

    <Border Grid.Row="1" Background="#EEF4EF" BorderBrush="#C6D5C9" BorderThickness="1" Padding="9" Margin="0,10,0,0">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Content="Install SRAM simulator" Command="{Binding InstallCommand}" Padding="10,4" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" FontStyle="Italic"
                               Text="{Binding IsInstalled, StringFormat='installed for this session: {0}'}" />
        </Grid>
        <!--
                    Same safeguard as the real SRAM Tentacle window; see
                    SramSimulatorViewModel.IdlePolicyWarningText.
                -->
        <Border Margin="0,7,0,0" Padding="7" Background="#FFF3CD" BorderBrush="#E0C266" BorderThickness="1"
                        Visibility="{Binding HasIdlePolicyWarning, Converter={StaticResource BoolToVis}}">
          <TextBlock TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold" Foreground="#7A5200"
                               Text="{Binding IdlePolicyWarningText}" />
        </Border>
      </StackPanel>
    </Border>

    <GroupBox Grid.Row="2" Header="echo -- node 707 call/return test" Margin="0,10,0,0" Padding="8">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Value:" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding EchoValueText, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" />
          <Button Grid.Column="2" Content="Echo test" Command="{Binding EchoTestCommand}" Padding="10,4" Margin="10,0,0,0" />
          <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Consolas" FontWeight="SemiBold"
                               Text="{Binding EchoResultText}" />
        </Grid>
        <TextBlock Margin="0,6,0,0" Foreground="#555" TextWrapping="Wrap" FontSize="11"
                           Text="{Binding EchoReferenceText}" />
      </StackPanel>
    </GroupBox>

    <GroupBox Grid.Row="3" Header="ex@ / ex! -- read and write one word" Margin="0,10,0,0" Padding="8">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Page (0-F):" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding PageText, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" />
          <TextBlock Grid.Column="2" Text="Address:" VerticalAlignment="Center" Margin="10,0,0,0" />
          <TextBox Grid.Column="3" Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" />
          <TextBlock Grid.Column="4" Text="Value:" VerticalAlignment="Center" Margin="10,0,0,0" />
          <TextBox Grid.Column="5" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" />
          <Button Grid.Column="6" Content="Read" Command="{Binding ReadCommand}" Padding="10,4" Margin="10,0,0,0" />
          <Button Grid.Column="7" Content="Write" Command="{Binding WriteCommand}" Padding="10,4" Margin="6,0,0,0" />
          <TextBlock Grid.Column="9" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Consolas" FontWeight="SemiBold"
                           Text="{Binding ReadResultText}" />
        </Grid>
        <TextBlock Margin="0,6,0,0" Foreground="#555" TextWrapping="Wrap" FontSize="11"
                           Text="{Binding PageAddressReferenceText}" />
      </StackPanel>
    </GroupBox>

    <GroupBox Grid.Row="4" Header="cx? -- compare-and-exchange (uses Page/Address above)" Margin="0,10,0,0" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Compare to:" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding CompareValueText, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" />
        <TextBlock Grid.Column="2" Text="Store if equal:" VerticalAlignment="Center" Margin="10,0,0,0" />
        <TextBox Grid.Column="3" Text="{Binding NewValueText, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" />
        <Button Grid.Column="4" Content="Compare-and-exchange" Command="{Binding CompareExchangeCommand}" Padding="10,4" Margin="10,0,0,0" />
        <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold"
                           Text="{Binding CompareExchangeResultText}" />
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="5" Header="mk! -- master enable / stimulus mask (protocol no-op here)" Margin="0,10,0,0" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Mask:" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding MaskText, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" />
        <CheckBox Grid.Column="2" Content="Post stimuli (f=1)" VerticalAlignment="Center" Margin="14,0,0,0"
                            IsChecked="{Binding PostStimuli}" />
        <Button Grid.Column="3" Content="Set mask" Command="{Binding SetMaskCommand}" Padding="10,4" Margin="14,0,0,0" />
      </Grid>
    </GroupBox>

    <!--
            Read-only TextBoxes, not TextBlock/ListBox; see SramTentacleWindow's identical
            reasoning: a TextBlock/ListBox cannot have its text selected/copied in WPF.
        -->
    <TextBox Grid.Row="6" Margin="0,10,0,4" Text="{Binding StatusText, Mode=OneWay}"
                  IsReadOnly="True" IsReadOnlyCaretVisible="True"
                  BorderThickness="0" Background="Transparent"
                  FontWeight="SemiBold" TextWrapping="Wrap" />

    <TextBox x:Name="LogTextBox" Grid.Row="7" Text="{Binding LogText, Mode=OneWay}"
                  IsReadOnly="True" IsReadOnlyCaretVisible="True"
                  FontFamily="Consolas" FontSize="11"
                  TextWrapping="Wrap"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  TextChanged="OnLogTextChanged" />
  </Grid>
</Window>