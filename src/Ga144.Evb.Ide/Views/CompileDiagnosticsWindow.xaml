<Window x:Class="Ga144.Evb.Ide.Views.CompileDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compilation diagnostics"
        Width="620"
        Height="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               x:Name="HeaderText"
               FontWeight="Bold"
               TextWrapping="Wrap"
               Margin="0,0,0,6" />

    <TextBox Grid.Row="1"
             x:Name="DiagnosticsText"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"
             FontFamily="Consolas"
             IsInactiveSelectionHighlightEnabled="True" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Copy all" MinWidth="90" Margin="0,0,8,0" Click="OnCopyClick" />
      <Button Content="Close" MinWidth="90" IsCancel="True" Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>
