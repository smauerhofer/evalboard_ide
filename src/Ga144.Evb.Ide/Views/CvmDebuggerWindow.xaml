<Window x:Class="Ga144.Evb.Ide.Views.CvmDebuggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CVM Debugger"
        Width="1040"
        Height="1040"
        MinWidth="820"
        MinHeight="760"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="CVM Debugger" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Margin="0,3,0,0" Foreground="#555" TextWrapping="Wrap"
                       Text="Compiles and boots the CVM cluster exactly like &quot;Install &amp; run CVM test&quot;, loads the same shared test program into a simulated 1 Mword SRAM, wakes node 708's 'start -- but instead of servicing the resulting traffic to completion, pauses so you can step one memory-interface transaction at a time, run to a breakpoint, and inspect the simulated SRAM. Real hardware: a breakpointed read is paused by withholding its reply, which is what the physical CVM is actually blocked on." />
    </StackPanel>

    <Border Grid.Row="1" Background="#EEF4EF" BorderBrush="#C6D5C9" BorderThickness="1" Padding="9" Margin="0,10,0,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Content="Start / Reinstall" Command="{Binding StartCommand}" Padding="12,6" Margin="0,0,8,0"
                          ToolTip="Compiles this project's own CVM node sources, resets the chip, boots the mesh, loads the shared test program into simulated SRAM, and wakes node 708's 'start. Blocked while a Kraken is erected." />
          <Button Content="Step" Command="{Binding StepCommand}" Padding="12,6" Margin="0,0,8,0"
                          ToolTip="Services exactly one memory-interface transaction (one read or one write), ignoring breakpoints -- always executes the next full instruction fetch or stack access." />
          <Button Content="Continue" Command="{Binding ContinueCommand}" Padding="12,6" Margin="0,0,8,0"
                          ToolTip="Services transactions back-to-back until an armed breakpoint's read reply is withheld, the transaction cap is reached, or you click Pause." />
          <Button Content="Run" Command="{Binding RunCommand}" Padding="12,6" Margin="0,0,8,0"
                          ToolTip="Same as Continue, but with no transaction cap at all -- runs until an armed breakpoint's read reply is withheld or you click Pause." />
          <Button Content="Pause" Command="{Binding PauseCommand}" Padding="12,6" Margin="0,0,8,0"
                          ToolTip="Stops the current Continue after its transaction in progress finishes." />
          <Button Content="Stop" Command="{Binding StopCommand}" Padding="12,6" Margin="0,0,8,0"
                          ToolTip="Ends this debugging session: cancels any run in progress and closes the serial port to the chip. The window stays open -- click Start / Reinstall to reconnect." />
          <Button Content="Core Dump..." Command="{Binding CoreDumpCommand}" Padding="12,6" Margin="0,0,8,0"
                          ToolTip="Stops any active debug session, resets the chip, installs Kraken on node 708, and reads every other node's A, IO, RAM, ROM, and both stacks -- opening a read-only post-mortem GA144 window with the result. Reading the stacks pops them off the live node. Kraken remains installed afterward." />
          <TextBlock Text="PC:" VerticalAlignment="Center" Margin="14,0,4,0" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ProgramCounterText}" VerticalAlignment="Center" FontFamily="Consolas" FontWeight="SemiBold" />
        </StackPanel>
        <CheckBox Content="Fill stacks with 0x1555x debug pattern before starting" Margin="0,6,0,0"
                        IsChecked="{Binding FillStacksWithDebugPoison}"
                        ToolTip="On (default): before each node's own real return/parameter stack initialization, Start/Reinstall first overwrites both stacks with a 0x15550 (top) .. sentinel pattern down to the bottom -- 0x15558 for the 9-word return stack, 0x15559 for the 10-word data stack -- so any of these values still on a stack once the program is running identifies a slot it never actually touched. Turn off for a run where only the node's own real stack values should be present at boot." />
        <TextBox Margin="0,7,0,0" Text="{Binding StatusText, Mode=OneWay}"
                        IsReadOnly="True" IsReadOnlyCaretVisible="True"
                        BorderThickness="0" Background="Transparent"
                        FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBox Margin="0,2,0,0" Text="{Binding InstallSummaryText, Mode=OneWay}"
                        IsReadOnly="True" IsReadOnlyCaretVisible="True"
                        BorderThickness="0" Background="Transparent"
                        Foreground="#555" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- The old "Breakpoints (page:address...)" GroupBox (a typed address, Add/Remove selected/Clear
         all, and a plain ListBox of "p:aaaa" strings) was removed 2026-09-26 per Stefan: "remove the
         breakpoints dialog above the source area from C and CVM debugger. it is no longer needed."
         Setting a breakpoint is now done directly in the "Simulated SRAM inspector" below, by clicking
         a row's own gutter cell (see that ListView's own remarks), independent of whether a program
         is running, per Stefan's own request. -->
    <GroupBox Grid.Row="2" Header="Assembly Code (edit, then Assemble to load into the simulated SRAM)" Margin="0,10,0,0" Padding="8">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
          <TextBlock Text="Program:" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram}"
                          DisplayMemberPath="Name" Width="200" Margin="0,0,8,0"
                          ToolTip="Switch between this chip's own named CVM Debugger programs -- selecting one loads and re-assembles it automatically, no separate Load step. The first one is always &quot;default&quot;, which always loads the original built-in test program, whatever text was last saved under that name. Switching away first commits the outgoing program's own edited text, so it isn't lost." />
          <Button Content="Add" Command="{Binding AddProgramCommand}" Padding="10,4" Margin="0,0,16,0"
                          ToolTip="Adds a new, empty, uniquely-named program to this chip and selects it. Not persisted until you click Save." />
          <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox Text="{Binding ProgramNameText, UpdateSourceTrigger=PropertyChanged}" Width="200" VerticalAlignment="Center"
                          ToolTip="This program's name -- always shows the currently selected program. Edit it and click Save to rename." />
        </StackPanel>
        <TextBox Text="{Binding AssemblyCodeText, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="True" AcceptsTab="True"
                        FontFamily="Consolas" FontSize="12"
                        Height="220"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto" />
        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
          <Button Content="Assemble" Command="{Binding AssembleCommand}" Padding="12,6" Margin="0,0,8,0"
                          ToolTip="Assembles this source against node 607's current compile and loads the result into a simulated SRAM's page 0, starting at address 0. With a chip connected, this is a live reprogram of whatever it's actually reading from. With none, it assembles into a standalone simulated SRAM instead -- so you can write and check a program before ever clicking Start; Start then applies it to the chip automatically." />
          <Button Content="Save" Command="{Binding SaveCommand}" Padding="12,6" Margin="0,0,8,0"
                          ToolTip="Saves this program's text and name (renaming it if the Name box was changed) onto this chip's own project data, so it's still here next time you open the CVM Debugger. Also persists every OTHER program currently listed above. Rides the IDE's normal auto-save -- no separate file to manage." />
          <Button Content="Restore" Command="{Binding RestoreCommand}" Padding="12,6"
                          ToolTip="Reloads the currently selected program from what was last saved to the project, undoing any unsaved edits to its text or a not-yet-saved rename (selecting &quot;default&quot; always shows the built-in test program, same as before, so restoring it shows that same text). Has no effect on a brand-new, never-saved program other than saying so." />
        </StackPanel>
        <Separator Margin="0,10,0,8" />
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Or, load an already-linked program instead of typing CVM assembly by hand:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#555" />
          <Button Content="Load linked image (.gaimg)..." Click="OnLoadImageClick" Padding="12,6"
                          ToolTip="Loads a .gaimg file (galink's own output, e.g. from a Program project's Build) straight into the simulated SRAM -- no assembly step, since every word is already fully resolved. Independent of the Assembly Code editor above; its own symbol table then labels the memory inspector's rows by name until Assemble or a fresh Start replaces it." />
        </StackPanel>
      </StackPanel>
    </GroupBox>

    <GroupBox Grid.Row="3" Header="Simulated SRAM inspector" Margin="0,10,0,0" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Show from:" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding MemoryBaseText, UpdateSourceTrigger=PropertyChanged}" Margin="6,0" />
        <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshMemoryCommand}" Padding="10,4" />
      </Grid>
    </GroupBox>

    <TextBlock Grid.Row="4" Margin="0,10,0,4" FontWeight="SemiBold" Text="Simulated SRAM (read-only)" />
    <Grid Grid.Row="5">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Text="{Binding MemoryStatusText}" Foreground="#A33333" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
      <ListView Grid.Row="1" ItemsSource="{Binding MemoryRows}"
                      FontFamily="Consolas" FontSize="11"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListView.View>
          <GridView>
            <!-- The gutter column Stefan asked for directly: right after the address, showing the
                 current PC (a green arrow) and any armed breakpoint (a red circle, to the arrow's own
                 left, per Stefan, 2026-09-26: "the first column... displays a breakpoint with a red
                 circle and the current program position... with a green arrow to the right"); clicking
                 anywhere in this cell toggles a breakpoint at that row's own address, via
                 CvmDebuggerViewModel.ToggleBreakpointAtAddress. Shared verbatim by the C Debugger's own
                 memory inspector, per Stefan: "use the same column for the old CVM debugger". Works
                 whether or not a debug session is currently running (see ToggleBreakpointAtAddress's
                 own remarks); this is the ONLY way to set or clear a breakpoint, replacing the old
                 "Breakpoints" GroupBox that used to sit above the source area (removed 2026-09-26, per
                 Stefan: "it is no longer needed"). Two separate TextBlocks (rather than one string, as
                 the former GutterText property used to be) are what let the circle and arrow carry
                 different colors; both are wrapped in one StackPanel so the WHOLE cell, not just
                 whichever glyph happens to be showing, stays the click target. -->
            <GridViewColumn Header="" Width="40">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                  Background="Transparent" Cursor="Hand"
                                  ToolTip="Click to set or clear a breakpoint at this address -- works whether or not a debug session is running."
                                  MouseLeftButtonDown="OnMemoryGutterClick">
                    <TextBlock Text="●" FontWeight="Bold" Foreground="#B00020"
                                    Visibility="{Binding IsBreakpoint, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="→" FontWeight="Bold" Foreground="#1B8A3B"
                                    Visibility="{Binding IsCurrentPc, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Address" Width="80" DisplayMemberBinding="{Binding AddressText}" />
            <GridViewColumn Header="Value" Width="60" DisplayMemberBinding="{Binding ValueText}" />
            <!-- Added 2026-09-26 per Stefan: "add a column 'Label' between 'Value' and 'Disassembly'
                 and put in there the name of a label for that address"; see
                 CvmDebuggerViewModel.RefreshMemoryView's own remarks for where a label can come from. -->
            <GridViewColumn Header="Label" Width="120" DisplayMemberBinding="{Binding LabelText}" />
            <GridViewColumn Header="Disassembly" Width="260" DisplayMemberBinding="{Binding DisassemblyText}" />
            <!-- Empty for the ordinary CVM Debugger's own hand-typed/loaded programs; only ever
                 populated when the C Debugger's own compile pipeline loaded what's showing here. -->
            <GridViewColumn Header="C source" Width="280" DisplayMemberBinding="{Binding SourceCommentText}" />
          </GridView>
        </ListView.View>
      </ListView>
    </Grid>

    <Grid Grid.Row="6" Margin="0,10,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock FontWeight="SemiBold" Text="Transaction log (read-only)" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Copy log" Padding="10,2" Click="OnCopyLogClick"
                      ToolTip="Copies the full transaction log to the clipboard." />
    </Grid>
    <TextBox x:Name="LogTextBox" Grid.Row="7" Text="{Binding LogText, Mode=OneWay}"
                  IsReadOnly="True" IsReadOnlyCaretVisible="True"
                  FontFamily="Consolas" FontSize="11"
                  TextWrapping="Wrap"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  TextChanged="OnLogTextChanged" />
  </Grid>
</Window>