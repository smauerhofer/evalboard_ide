<Window x:Class="Ga144.Evb.Ide.Views.KrakenCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check Kraken"
        Width="1320"
        Height="820"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Kraken RAM[0] path check" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding EndpointText, Mode=OneWay}" Foreground="#555" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ProgressText, Mode=OneWay}" FontFamily="Consolas" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="14,6" MinWidth="90" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#EEF4EF" BorderBrush="#C6D5C9" BorderThickness="1" Padding="9" Margin="0,10,0,10">
            <StackPanel>
                <TextBlock Text="{Binding OrderText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CheckDescription, Mode=OneWay}" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  FontFamily="Consolas"
                  RowHeaderWidth="0">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="PASS">
                            <Setter Property="Background" Value="#E7F5EA" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="FAIL">
                            <Setter Property="Background" Value="#FCE8E8" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="SKIP">
                            <Setter Property="Background" Value="#F1F1F1" />
                            <Setter Property="Foreground" Value="#777" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Node" Binding="{Binding Node}" Width="72" />
                <DataGridTextColumn Header="Tentacle" Binding="{Binding Tentacle}" Width="80" />
                <DataGridTextColumn Header="Pos" Binding="{Binding PositionText}" Width="58" />
                <DataGridTextColumn Header="Incoming" Binding="{Binding IncomingPort}" Width="82" />
                <DataGridTextColumn Header="Outgoing" Binding="{Binding OutgoingPort}" Width="82" />
                <DataGridTextColumn Header="Expected RAM[0]" Binding="{Binding Expected}" Width="155" />
                <DataGridTextColumn Header="Read RAM[0]" Binding="{Binding Actual}" Width="155" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="72" />
                <DataGridTextColumn Header="Detail" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#F6F6F6" BorderBrush="#D0D0D0" BorderThickness="1" Padding="9" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText, Mode=OneWay}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
